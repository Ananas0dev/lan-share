# Replace the hostname and TLS paths. Limit reachability to your intended LAN.
server {
    listen 443 ssl;
    server_name share.example.com;
    ssl_certificate /etc/ssl/local/share/fullchain.pem;
    ssl_certificate_key /etc/ssl/local/share/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location = / { return 302 /share/; }
    location = /share { return 301 /share/; }
    location /share/ {
        client_max_body_size 0;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 3600s;
        proxy_read_timeout 3600s;
        proxy_pass http://127.0.0.1:8765/;
    }
}
